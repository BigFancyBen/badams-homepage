{
  "name": "scrandle-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "type-check": "tsc --noEmit",
    "migrate": "wrangler d1 migrations apply scrandle --remote",
    "migrate:local": "node scripts/make-test-config.mjs && wrangler d1 migrations apply scrandle --local --config wrangler.test.toml",
    "test:interactions": "node scripts/test-interactions.mjs",
    "test:config": "node scripts/make-test-config.mjs",
    "dev:local": "node scripts/make-test-config.mjs && wrangler dev --local --config wrangler.test.toml --port 8787",
    "db:local": "node scripts/make-test-config.mjs && wrangler d1 execute scrandle --local --config wrangler.test.toml",
    "mock:discord": "node scripts/mock-discord.mjs",
    "test:matchups": "node scripts/simulate-matchups.mjs",
    "test:rounds": "node scripts/simulate-rounds.mjs",
    "test:contests": "node scripts/simulate-contests.mjs",
    "test:schedule": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-schedule.mjs",
    "test:ingest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-ingest.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0"
  }
}
